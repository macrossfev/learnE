<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LearnE" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/mecha_red</item>
        <item name="colorPrimaryDark">@color/mecha_red_dark</item>
        <item name="colorAccent">@color/mecha_gold</item>
        <item name="android:windowBackground">@color/mecha_offwhite</item>
        <item name="android:statusBarColor">@color/mecha_hull</item>
        <item name="android:navigationBarColor">@color/mecha_hull</item>
    </style>

    <style name="AutoPlayProgress" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_gundam</item>
        <item name="android:minHeight">8dp</item>
    </style>

    <!-- Mecha button styles -->
    <style name="MechaButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/mecha_white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:padding">16dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="MechaButtonAccent" parent="MechaButton">
        <item name="android:background">@drawable/btn_accent</item>
    </style>

    <style name="MechaCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/mecha_white</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">0dp</item>
    </style>
</resources>