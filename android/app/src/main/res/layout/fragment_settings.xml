<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mecha_hull"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <TextView
        android:id="@+id/tv_corpus_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="语料库选择"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_settings_title"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="16dp" />

    <RadioGroup
        android:id="@+id/rg_corpus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tv_corpus_label">

        <RadioButton
            android:id="@+id/rb_cet4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/corpus_cet4" />

        <RadioButton
            android:id="@+id/rb_catti"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/corpus_catti" />

    </RadioGroup>

</androidx.constraintlayout.widget.ConstraintLayout>