<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mecha_hull">

    <!-- Top HUD bar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/panel_dark"
        android:elevation="4dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="◀ 返回"
            android:textColor="@color/mecha_white"
            android:textSize="12sp"
            android:background="@drawable/btn_accent"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="12dp"
            android:letterSpacing="0.05"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="听写模式"
            android:textColor="@color/mecha_gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"/>

        <TextView
            android:id="@+id/tv_progress_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/mecha_armor"
            android:textSize="12sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- Loading -->
    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/mecha_hull"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/mecha_gold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="正在加载词库..."
            android:textColor="@color/mecha_armor"
            android:textSize="14sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- Group map -->
    <LinearLayout
        android:id="@+id/layout_group_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/mecha_hull">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/panel_dark"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_map_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="听写模式"
                android:textColor="@color/mecha_gold"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/layout_group_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"/>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/panel_dark"
            android:padding="8dp"
            android:gravity="center">

            <Button
                android:id="@+id/btn_start_dictation"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="▶ 开始听写"
                android:textColor="@color/mecha_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:letterSpacing="0.05"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Dictation interface -->
    <LinearLayout
        android:id="@+id/layout_dictation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/AutoPlayProgress"
            android:layout_width="match_parent"
            android:layout_height="4dp"/>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <Button
                android:id="@+id/btn_play_audio"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="▶"
                android:textColor="@color/mecha_white"
                android:textSize="28sp"
                android:background="@drawable/btn_accent"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tv_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击播放按钮听发音"
                android:textColor="@color/mecha_armor"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="24dp"/>

            <EditText
                android:id="@+id/et_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="输入单词..."
                android:textSize="20sp"
                android:padding="12dp"
                android:background="@color/mecha_panel"
                android:textColor="@color/mecha_white"
                android:textColorHint="@color/mecha_armor_dark"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:layout_marginBottom="16dp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tv_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_submit"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:text="提交"
                    android:textColor="@color/mecha_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary"
                    android:letterSpacing="0.05"/>

                <Button
                    android:id="@+id/btn_next"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:text="下一词 ▶"
                    android:textColor="@color/mecha_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_accent"
                    android:layout_marginStart="16dp"
                    android:visibility="gone"
                    android:letterSpacing="0.05"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
