<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mecha_hull">

    <!-- Top HUD bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/panel_dark"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="每日挑战"
            android:textColor="@color/mecha_gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 10"
            android:textColor="@color/mecha_armor"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="@style/AutoPlayProgress"
        android:layout_width="match_parent"
        android:layout_height="4dp"/>

    <!-- Main content -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Choice layout -->
        <LinearLayout
            android:id="@+id/choice_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择正确的释义"
                android:textColor="@color/mecha_armor"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_word_for_choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/mecha_gold"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="24dp"
                android:gravity="center"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button android:id="@+id/btn_choice_option_1" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="8dp" android:textSize="15sp" android:textColor="@color/mecha_white" android:background="@drawable/btn_accent" android:gravity="center" android:letterSpacing="0.03"/>
                <Button android:id="@+id/btn_choice_option_2" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="8dp" android:textSize="15sp" android:textColor="@color/mecha_white" android:background="@drawable/btn_accent" android:gravity="center" android:letterSpacing="0.03"/>
                <Button android:id="@+id/btn_choice_option_3" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="8dp" android:textSize="15sp" android:textColor="@color/mecha_white" android:background="@drawable/btn_accent" android:gravity="center" android:letterSpacing="0.03"/>
                <Button android:id="@+id/btn_choice_option_4" android:layout_width="match_parent" android:layout_height="56dp" android:textSize="15sp" android:textColor="@color/mecha_white" android:background="@drawable/btn_accent" android:gravity="center" android:letterSpacing="0.03"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Spell layout -->
        <LinearLayout
            android:id="@+id/spell_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="听写拼写"
                android:textColor="@color/mecha_armor"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_spell_play"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:text="▶"
                android:textColor="@color/mecha_white"
                android:textSize="28sp"
                android:background="@drawable/btn_accent"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_spell_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/mecha_hud_orange"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/et_spell_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="输入单词..."
                android:textSize="18sp"
                android:padding="12dp"
                android:background="@color/mecha_panel"
                android:textColor="@color/mecha_white"
                android:textColorHint="@color/mecha_armor_dark"
                android:inputType="textMultiLine"
                android:imeOptions="actionDone"
                android:layout_marginBottom="8dp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tv_spell_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_spell_submit"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:text="提交"
                    android:textColor="@color/mecha_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary"
                    android:letterSpacing="0.05"/>

                <Button
                    android:id="@+id/btn_spell_next"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:text="下一个 ▶"
                    android:textColor="@color/mecha_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_accent"
                    android:layout_marginStart="16dp"
                    android:visibility="gone"
                    android:letterSpacing="0.05"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Card layout -->
        <LinearLayout
            android:id="@+id/card_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/card_front"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/card_metal"
                android:padding="24dp"
                android:layout_marginBottom="16dp"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/tv_card_front"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/mecha_white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_gravity="center"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/card_back"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/panel_dark"
                android:padding="24dp"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_card_back_meaning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/mecha_gold"
                        android:textSize="22sp"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tv_card_back_phonetic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/mecha_armor"
                        android:textSize="16sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </FrameLayout>

            <Button
                android:id="@+id/btn_card_flip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="翻转"
                android:textColor="@color/mecha_white"
                android:textSize="15sp"
                android:background="@drawable/btn_gold"
                android:paddingHorizontal="24dp"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/tv_card_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="你认识这个词吗?"
                android:textColor="@color/mecha_armor"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_card_known"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:text="认识"
                    android:textColor="@color/mecha_white"
                    android:textSize="15sp"
                    android:background="@drawable/btn_accent"
                    android:visibility="gone"
                    android:letterSpacing="0.05"/>

                <Button
                    android:id="@+id/btn_card_forgot"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:text="不认识"
                    android:textColor="@color/mecha_white"
                    android:textSize="15sp"
                    android:background="@drawable/btn_primary"
                    android:layout_marginStart="16dp"
                    android:visibility="gone"
                    android:letterSpacing="0.05"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Loading -->
    <FrameLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/mecha_hull">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/mecha_gold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="正在加载挑战..."
                android:textColor="@color/mecha_armor"
                android:textSize="14sp"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
