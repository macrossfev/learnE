<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8E8E8"
    android:orientation="vertical">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="每日挑战"
            android:textColor="#E3000F"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 10"
            android:textColor="#808080"
            android:textSize="13sp"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- 进度条 -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:progress="0"
        android:progressDrawable="@drawable/progress_gundam"/>

    <!-- 主内容区 -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 选择题布局 -->
        <LinearLayout
            android:id="@+id/choice_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择正确的释义"
                android:textColor="#808080"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_word_for_choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#000000"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"
                android:gravity="center"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_choice_option_1"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:backgroundTint="#0039CB"/>

                <Button
                    android:id="@+id/btn_choice_option_2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:backgroundTint="#0039CB"/>

                <Button
                    android:id="@+id/btn_choice_option_3"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:backgroundTint="#0039CB"/>

                <Button
                    android:id="@+id/btn_choice_option_4"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:backgroundTint="#0039CB"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 拼写题布局 -->
        <LinearLayout
            android:id="@+id/spell_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="听写拼写"
                android:textColor="#808080"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_spell_play"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:text="播放"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#0039CB"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_spell_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FF9800"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/et_spell_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="输入单词..."
                android:textSize="18sp"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:inputType="textMultiLine"
                android:imeOptions="actionDone"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_spell_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_spell_submit"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:text="提交"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:backgroundTint="#E3000F"/>

                <Button
                    android:id="@+id/btn_spell_next"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:text="下一个"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:backgroundTint="#0039CB"
                    android:layout_marginStart="16dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 闪卡题布局 -->
        <LinearLayout
            android:id="@+id/card_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/card_front"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:padding="24dp"
                android:layout_marginBottom="16dp"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/tv_card_front"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#000000"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/card_back"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFF8F0"
                android:padding="24dp"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_card_back_meaning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#E3000F"
                        android:textSize="22sp"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tv_card_back_phonetic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#808080"
                        android:textSize="16sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </FrameLayout>

            <Button
                android:id="@+id/btn_card_flip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="翻转"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#0039CB"
                android:paddingHorizontal="24dp"/>

            <TextView
                android:id="@+id/tv_card_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="你认识这个词吗?"
                android:textColor="#808080"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_card_known"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:text="认识"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:backgroundTint="#4CAF50"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btn_card_forgot"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:text="不认识"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:backgroundTint="#F44336"
                    android:layout_marginStart="16dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 加载指示器 -->
    <FrameLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#E3000F"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="正在加载挑战..."
                android:textColor="#000000"
                android:textSize="14sp"/>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
