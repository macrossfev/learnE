<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mecha_hull">

    <!-- Top HUD bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/panel_dark"
        android:elevation="4dp">

        <Button
            android:id="@+id/btn_exit_fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="◀ 退出"
            android:textColor="@color/mecha_white"
            android:textSize="12sp"
            android:background="@drawable/btn_accent"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="12dp"
            android:letterSpacing="0.05"/>

        <TextView
            android:id="@+id/tv_fullscreen_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="听读模式"
            android:textColor="@color/mecha_gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"/>

        <TextView
            android:id="@+id/tv_fullscreen_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/mecha_armor"
            android:textSize="12sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progress_bar_fullscreen"
        style="@style/AutoPlayProgress"
        android:layout_width="match_parent"
        android:layout_height="4dp"/>

    <!-- Content area -->
    <ScrollView
        android:id="@+id/scroll_fullscreen_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/fullscreen_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal"/>
    </ScrollView>

    <!-- Bottom control bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical"
        android:background="@drawable/panel_dark">

        <Button
            android:id="@+id/btn_fullscreen_play"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="▶ 播放"
            android:textColor="@color/mecha_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:paddingHorizontal="16dp"
            android:minWidth="90dp"
            android:letterSpacing="0.05"/>

        <Button
            android:id="@+id/btn_fullscreen_pause"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="⏸ 暂停"
            android:textColor="@color/mecha_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/card_metal"
            android:paddingHorizontal="16dp"
            android:minWidth="90dp"
            android:layout_marginStart="6dp"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <Button
            android:id="@+id/btn_fullscreen_prev"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:text="◀"
            android:textColor="@color/mecha_white"
            android:textSize="16sp"
            android:background="@drawable/btn_accent"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btn_fullscreen_next"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:text="▶"
            android:textColor="@color/mecha_white"
            android:textSize="16sp"
            android:background="@drawable/btn_accent"
            android:padding="0dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

</LinearLayout>
