<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/mecha_hull"
    android:padding="32dp">

    <!-- Mecha title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LearnE"
        android:textColor="@color/mecha_gold"
        android:textSize="40sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CORPUS ENGLISH SYSTEM"
        android:textColor="@color/mecha_armor"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:layout_marginBottom="48dp"/>

    <!-- Login panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_dark"
        android:padding="24dp"
        android:layout_marginHorizontal="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— 系统登录 —"
            android:textColor="@color/mecha_hud_cyan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USER ID"
            android:textColor="@color/mecha_armor"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"/>

        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="用户名"
            android:inputType="text"
            android:autofillHints="username"
            android:background="@color/mecha_panel"
            android:paddingHorizontal="14dp"
            android:textColor="@color/mecha_white"
            android:textColorHint="@color/mecha_armor_dark"
            android:textSize="14sp"
            android:fontFamily="monospace"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASSKEY"
            android:textColor="@color/mecha_armor"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="密码"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:background="@color/mecha_panel"
            android:paddingHorizontal="14dp"
            android:textColor="@color/mecha_white"
            android:textColorHint="@color/mecha_armor_dark"
            android:textSize="14sp"
            android:fontFamily="monospace"/>

        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="▶ 启 动 系 统"
            android:textColor="@color/mecha_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:letterSpacing="0.1"/>

    </LinearLayout>

    <!-- Bottom HUD decoration -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="SYS.v2.0 // AUTH REQUIRED"
        android:textColor="@color/mecha_armor_dark"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"/>

</LinearLayout>
