<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mecha_hull">

    <!-- Top HUD bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/panel_dark"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="闪卡模式"
            android:textColor="@color/mecha_gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_direction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="英→中"
            android:textColor="@color/mecha_hud_cyan"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="4dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 50"
            android:textColor="@color/mecha_armor"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="@style/AutoPlayProgress"
        android:layout_width="match_parent"
        android:layout_height="4dp"/>

    <!-- Main content -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <!-- Flashcard -->
        <FrameLayout
            android:id="@+id/card_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp">

            <!-- Front -->
            <LinearLayout
                android:id="@+id/card_front"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_metal"
                android:padding="24dp"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/tv_card_front_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/mecha_white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_card_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击翻转查看答案"
                    android:textColor="@color/mecha_armor_dark"
                    android:textSize="13sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Back -->
            <LinearLayout
                android:id="@+id/card_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/panel_dark"
                android:padding="24dp"
                android:elevation="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_card_back_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/mecha_hud_cyan"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_card_back_phonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/mecha_armor"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tv_card_back_meaning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/mecha_gold"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tv_card_back_phrase_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="词组"
                    android:textColor="@color/mecha_hud_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tv_card_back_phrase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/mecha_hud_cyan"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_card_back_phrase_meaning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/mecha_armor"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tv_card_back_example_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="例句"
                    android:textColor="@color/mecha_hud_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tv_card_back_example"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/mecha_armor_light"
                    android:textSize="14sp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tv_card_back_example_meaning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/mecha_armor"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择你的掌握程度"
                    android:textColor="@color/mecha_armor_dark"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="24dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Rating buttons -->
        <LinearLayout
            android:id="@+id/layout_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="center">

            <Button
                android:id="@+id/btn_forgot"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="不认识"
                android:textColor="@color/mecha_white"
                android:textSize="14sp"
                android:background="@drawable/btn_primary"
                android:letterSpacing="0.05"/>

            <Button
                android:id="@+id/btn_vague"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="模糊"
                android:textColor="@color/mecha_white"
                android:textSize="14sp"
                android:background="@drawable/btn_gold"
                android:layout_marginHorizontal="8dp"
                android:letterSpacing="0.05"/>

            <Button
                android:id="@+id/btn_known"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="认识"
                android:textColor="@color/mecha_white"
                android:textSize="14sp"
                android:background="@drawable/btn_accent"
                android:letterSpacing="0.05"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom control bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        android:background="@drawable/panel_dark">

        <Button
            android:id="@+id/btn_prev"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:text="◀"
            android:textColor="@color/mecha_white"
            android:textSize="14sp"
            android:background="@drawable/btn_accent"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btn_play"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="▶ 播放"
            android:textColor="@color/mecha_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:paddingHorizontal="14dp"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.05"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <Button
            android:id="@+id/btn_flip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="翻转"
            android:textColor="@color/mecha_white"
            android:textSize="12sp"
            android:background="@drawable/btn_gold"
            android:paddingHorizontal="14dp"
            android:letterSpacing="0.05"/>

        <Button
            android:id="@+id/btn_next"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:text="▶"
            android:textColor="@color/mecha_white"
            android:textSize="14sp"
            android:background="@drawable/btn_accent"
            android:padding="0dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Loading -->
    <FrameLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/mecha_hull">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/mecha_gold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="正在加载词库..."
                android:textColor="@color/mecha_armor"
                android:textSize="14sp"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
