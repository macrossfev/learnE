<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mecha_hull">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LearnE"
            android:textColor="@color/mecha_gold"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="— 选择语料库 —"
            android:textColor="@color/mecha_armor"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/tv_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="欢迎回来"
            android:textColor="@color/mecha_hud_cyan"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:visibility="gone"/>

        <!-- Corpus list -->
        <LinearLayout
            android:id="@+id/corpus_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"/>

        <!-- Returning user actions -->
        <LinearLayout
            android:id="@+id/layout_returning_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_continue_learn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="▶ 继续学习"
                android:textColor="@color/mecha_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:letterSpacing="0.05"/>

            <Button
                android:id="@+id/btn_change_corpus"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="更换"
                android:textColor="@color/mecha_white"
                android:textSize="13sp"
                android:background="@drawable/btn_accent"
                android:paddingHorizontal="16dp"
                android:letterSpacing="0.05"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Loading -->
    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/mecha_hull"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/mecha_gold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="正在获取语料库列表..."
            android:textColor="@color/mecha_armor"
            android:textSize="13sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

</FrameLayout>
