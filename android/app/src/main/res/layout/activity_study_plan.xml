<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mecha_hull"
    android:padding="24dp"
    android:gravity="center">

    <!-- Mecha title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LearnE"
        android:textColor="@color/mecha_gold"
        android:textSize="40sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:layout_gravity="center_horizontal"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MISSION CONTROL"
        android:textColor="@color/mecha_armor"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.25"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp"/>

    <!-- 4 main buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="36dp">

        <!-- 新的学习 -->
        <Button
            android:id="@+id/btn_new_journey"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶ 新的学习"
            android:textColor="@color/mecha_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.08"/>

        <!-- 继续学习 -->
        <Button
            android:id="@+id/btn_continue_journey"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶ 继续学习"
            android:textColor="@color/mecha_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_accent"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.08"/>

        <!-- 选项 -->
        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⚙ 选项"
            android:textColor="@color/mecha_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_gold"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.08"/>

        <!-- 退出 -->
        <Button
            android:id="@+id/btn_exit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="■ 退出系统"
            android:textColor="@color/mecha_armor"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/card_metal"
            android:letterSpacing="0.08"/>

    </LinearLayout>

    <!-- Bottom HUD decoration -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="SYS.ONLINE // READY"
        android:textColor="@color/mecha_armor_dark"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"/>

</LinearLayout>
