<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mecha_hull"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_stats_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="学习统计"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <TextView
        android:id="@+id/tv_learned_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已学习: 0"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_stats_title"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_mastered_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已掌握: 0"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_learned_count"
        app:layout_constraintLeft_toLeftOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>