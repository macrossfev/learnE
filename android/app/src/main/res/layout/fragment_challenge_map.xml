<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mecha_hull">

    <!-- ===== TOP HUD BAR ===== -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_dark"
        android:padding="12dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_back_to_plans"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="◀ 返回"
                android:textColor="@color/mecha_white"
                android:textSize="12sp"
                android:background="@drawable/btn_accent"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="12dp"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/tv_plan_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="学习"
                android:textColor="@color/mecha_gold"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"/>

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连续0天"
                android:textColor="@color/mecha_hud_orange"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_progress"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="进度"
                android:textColor="@color/mecha_white"
                android:textSize="11sp"
                android:background="@drawable/btn_accent"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="8dp"
                android:minWidth="0dp"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/tv_review_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 组待复习"
                android:textColor="@color/mecha_hud_orange"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 0"
                android:textColor="@color/mecha_hud_cyan"
                android:textSize="13sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/AutoPlayProgress"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- ===== MAP GRID ===== -->
    <ScrollView
        android:id="@+id/scroll_map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layout_map_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"/>
    </ScrollView>

    <!-- ===== ACHIEVEMENTS BAR ===== -->
    <HorizontalScrollView
        android:id="@+id/layout_achievements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_dark"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layout_achievement_badges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <!-- ===== BOTTOM ACTION BUTTONS ===== -->
    <LinearLayout
        android:id="@+id/layout_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/panel_dark"
        android:padding="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_wrong"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="错题本"
            android:textColor="@color/mecha_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:layout_marginEnd="4dp"
            android:letterSpacing="0.05"/>

        <Button
            android:id="@+id/btn_starred"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="★ 星标本"
            android:textColor="@color/mecha_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_gold"
            android:layout_marginStart="4dp"
            android:letterSpacing="0.05"/>
    </LinearLayout>

    <!-- ===== LOADING OVERLAY ===== -->
    <FrameLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/mecha_hull">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/mecha_gold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="正在加载..."
                android:textColor="@color/mecha_armor"
                android:textSize="14sp"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
