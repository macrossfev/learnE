<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mecha_hull">

    <!-- Top HUD bar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/panel_dark"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 30"
            android:textColor="@color/mecha_gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="组 1 考试"
            android:textColor="@color/mecha_armor"
            android:textSize="13sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="@style/AutoPlayProgress"
        android:layout_width="match_parent"
        android:layout_height="4dp"/>

    <!-- Main content -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <!-- Choice layout -->
        <LinearLayout
            android:id="@+id/choice_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_word_for_choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/mecha_gold"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:fontFamily="monospace"/>

            <LinearLayout
                android:id="@+id/choice_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- Spell layout -->
        <LinearLayout
            android:id="@+id/spell_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_spell_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请根据听力拼写单词"
                android:textColor="@color/mecha_armor"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:fontFamily="monospace"/>

            <Button
                android:id="@+id/btn_spell_play"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="▶"
                android:textColor="@color/mecha_white"
                android:textSize="24sp"
                android:background="@drawable/btn_accent"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"/>

            <EditText
                android:id="@+id/et_spell_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="输入单词..."
                android:textSize="20sp"
                android:padding="12dp"
                android:background="@color/mecha_panel"
                android:textColor="@color/mecha_white"
                android:textColorHint="@color/mecha_armor_dark"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:layout_marginBottom="16dp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tv_spell_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_spell_submit"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:text="提交"
                    android:textColor="@color/mecha_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary"
                    android:letterSpacing="0.05"/>

                <Button
                    android:id="@+id/btn_spell_next"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:text="下一题 ▶"
                    android:textColor="@color/mecha_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_accent"
                    android:layout_marginStart="16dp"
                    android:visibility="gone"
                    android:letterSpacing="0.05"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Loading -->
    <FrameLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/mecha_hull">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/mecha_gold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="正在加载..."
                android:textColor="@color/mecha_armor"
                android:textSize="14sp"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
