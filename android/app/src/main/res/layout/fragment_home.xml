<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8E8E8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LearnE"
            android:textColor="#E3000F"
            android:textSize="40sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_corpus_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="CATTI"
            android:textColor="#808080"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_group_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="每组 30 个单词"
            android:textColor="#808080"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="选择学习模式"
            android:textColor="#000000"
            android:textSize="20sp"/>

        <!-- 交互学习模式 -->
        <LinearLayout
            android:id="@+id/btn_interactive_learn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="交互学习模式"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#E3000F"
                android:textSize="24sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3步学习：展示 → 选择题 → 填词，自动播放音频"
            android:textColor="#808080"
            android:textSize="13sp"
            android:paddingStart="20dp"
            android:layout_marginTop="4dp"
            android:paddingEnd="4dp"/>

        <!-- 听读模式 -->
        <LinearLayout
            android:id="@+id/btn_listen_read"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="听读模式"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#0039CB"
                android:textSize="24sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="卡片展示 + 自动播放音频，可设置重复次数"
            android:textColor="#808080"
            android:textSize="13sp"
            android:paddingStart="20dp"
            android:layout_marginTop="4dp"
            android:paddingEnd="4dp"/>

        <!-- 听写模式 -->
        <LinearLayout
            android:id="@+id/btn_dictation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="听写模式"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#FF9800"
                android:textSize="24sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="播放音频 → 输入拼写 → 判对错，锻炼拼写能力"
            android:textColor="#808080"
            android:textSize="13sp"
            android:paddingStart="20dp"
            android:layout_marginTop="4dp"
            android:paddingEnd="4dp"/>

        <!-- 闪卡模式 -->
        <LinearLayout
            android:id="@+id/btn_flashcard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="闪卡模式"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#4CAF50"
                android:textSize="24sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="翻转卡片 → 自评掌握度 → 间隔重复，科学记忆"
            android:textColor="#808080"
            android:textSize="13sp"
            android:paddingStart="20dp"
            android:layout_marginTop="4dp"
            android:paddingEnd="4dp"/>

        <!-- 每日挑战 -->
        <LinearLayout
            android:id="@+id/btn_daily_challenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="每日挑战"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#9C27B0"
                android:textSize="24sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="随机10词混战：选择+听写+闪卡，检验学习成果"
            android:textColor="#808080"
            android:textSize="13sp"
            android:paddingStart="20dp"
            android:layout_marginTop="4dp"
            android:paddingEnd="4dp"/>

        <!-- 学习统计 -->
        <LinearLayout
            android:id="@+id/btn_study_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="学习统计"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#607D8B"
                android:textSize="24sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="学习热力图 + 进度统计 + 连续打卡"
            android:textColor="#808080"
            android:textSize="13sp"
            android:paddingStart="20dp"
            android:layout_marginTop="4dp"
            android:paddingEnd="4dp"/>

        <!-- 错题本 -->
        <LinearLayout
            android:id="@+id/btn_wrong_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="错题本"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#F44336"
                android:textSize="24sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="复习易错单词，针对性强化薄弱环节"
            android:textColor="#808080"
            android:textSize="13sp"
            android:paddingStart="20dp"
            android:layout_marginTop="4dp"
            android:paddingEnd="4dp"/>

        <!-- 底部操作 -->
        <Button
            android:id="@+id/btn_change_plan"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="32dp"
            android:text="调整学习计划"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#808080"/>

        <Button
            android:id="@+id/btn_new_plan"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="重新选择计划"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#0039CB"/>

    </LinearLayout>

    <!-- 加载中 -->
    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#E3000F"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="正在获取语料库列表..."
            android:textColor="#000000"
            android:textSize="14sp"/>
    </LinearLayout>

</FrameLayout>
